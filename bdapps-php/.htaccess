# RobiTrail PHP Gateway - Apache / cPanel Access Hardening
# Prevents direct HTTP access to includes, sample config, or stray secret/log files.

Options -Indexes

<FilesMatch "^(config\.example\.php|.*\.config\.php|\.env.*|composer\.(json|lock)|.*\.log|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^includes/ - [F,L]
</IfModule>
<Files "robitrail_bdapps_config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>