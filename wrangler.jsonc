
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robitrail-4",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "vars": {
    "BDAPPS_APP_ID": "APP_140851",
    "BDAPPS_PHP_BASE_URL": "https://bdappsdigitalapps.com/auw26/RobiTrail",
    "FIREBASE_PROJECT_ID": "robitrail-c9e88",
    "FIRESTORE_DATABASE_ID": "(default)",
    "BDAPPS_MODE": "production",
    "ROBITRAIL_SMS_LOGIN_ENABLED": "true",
    "BDAPPS_LIVE_CHARGING_ENABLED": "false",
   "BDAPPS_SUBSCRIPTION_ENABLED": "true",
   "ROBITRAIL_SUBSCRIPTION_TERMS_TEXT": "RobiTrail subscription is free (BDT 0). No subscription fee is charged. Token purchases are optional and require separate payment authorization. Users can unsubscribe through subscription management."
  }
}
