
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robitrail-4",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
