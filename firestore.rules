rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global zero-trust safety net: deny all direct client access by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // All token wallets, purchase state transitions, idempotency locks, accounts,
    // and carrier subscription records are strictly server-managed via authenticated
    // backend transactions. Browser clients must NEVER read or mutate them directly.
    match /wallets/{walletKey} {
      allow read, write: if false;
    }

    match /tokenPurchases/{trxId} {
      allow read, write: if false;
    }

    match /processedKeys/{keyHash} {
      allow read, write: if false;
    }

    match /accounts/{walletKey} {
      allow read, write: if false;
    }

    match /subscriptions/{walletKey} {
      allow read, write: if false;
    }
  }
}
